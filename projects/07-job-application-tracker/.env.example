DATABASE_URL=postgresql://tracker:tracker@localhost:5432/job_tracker
REDIS_URL=redis://localhost:6379
BASE_URL=http://localhost:3000

# Used to sign session JWTs. Any long random string — generate one with:
#   openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string

# GitHub OAuth App credentials (https://github.com/settings/developers).
# Callback URL when registering the app: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (https://resend.com) — for sending reminder emails. The app runs
# fine without this set; reminder emails just get logged instead of sent.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=reminders@example.com
